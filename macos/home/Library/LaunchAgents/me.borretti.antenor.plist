<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>me.borretti.antenor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/eudoxia/.eudoxia.d/bin/antenor</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>info</string>
        <key>ANTENOR_PORT</key>
        <string>12004</string>
        <key>ANTENOR_DATA_DIRECTORY</key>
        <string>/Volumes/Asterion/Root/Databases/antenor</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/eudoxia/Library/Logs/antenor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/eudoxia/Library/Logs/antenor.log</string>
</dict>
</plist>
